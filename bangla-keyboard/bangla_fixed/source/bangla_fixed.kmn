c  Bangla Fixed - Probhat layout  (authentic, from m17n-db bn-probhat.mim)
c  Fixed 1:1 layout. Shift gives the upper-register letter/sign.
c  Build: kmc build

store(&NAME)            'Bangla Fixed (Probhat)'
store(&COPYRIGHT)       '(c) Bangla Keyboard Project'
store(&VERSION)         '10.0'
store(&KEYBOARDVERSION) '1.0'
store(&TARGETS)         'windows macosx linux web mobile'
store(&VISUALKEYBOARD)  'bangla_fixed.kvks'
store(&LAYOUTFILE)      'bangla_fixed.keyman-touch-layout'

begin Unicode > use(main)

group(main) using keys


c ---- numpad -> Bengali digits ----
  + [K_NP1] > '১'
  + [K_NP2] > '২'
  + [K_NP3] > '৩'
  + [K_NP4] > '৪'
  + [K_NP5] > '৫'
  + [K_NP6] > '৬'
  + [K_NP7] > '৭'
  + [K_NP8] > '৮'
  + [K_NP9] > '৯'
  + [K_NP0] > '০'

c ---- main Probhat map (unshifted + shifted) ----
  + '!' > '!'
  + '1' > '১'
  + '@' > '@'
  + '2' > '২'
  + '#' > '#'
  + '3' > '৩'
  + '$' > '৳'
  + '4' > '৪'
  + '%' > '%'
  + '5' > '৫'
  + '^' > '^'
  + '6' > '৬'
  + '&' > 'ঞ'
  + '7' > '৭'
  + '*' > 'ৎ'
  + '8' > '৮'
  + '(' > '('
  + '9' > '৯'
  + ')' > ')'
  + '0' > '০'
  + '_' > '_'
  + '-' > '-'
  + '+' > '+'
  + '=' > '='
  + 'Q' > 'ধ'
  + 'q' > 'দ'
  + 'W' > 'ঊ'
  + 'w' > 'ূ'
  + 'E' > 'ঈ'
  + 'e' > 'ী'
  + 'R' > 'ড়'
  + 'r' > 'র'
  + 'T' > 'ঠ'
  + 't' > 'ট'
  + 'Y' > 'ঐ'
  + 'y' > 'এ'
  + 'U' > 'উ'
  + 'u' > 'ু'
  + 'I' > 'ই'
  + 'i' > 'ি'
  + 'O' > 'ঔ'
  + 'o' > 'ও'
  + 'P' > 'ফ'
  + 'p' > 'প'
  + '{' > 'ৈ'
  + '[' > 'ে'
  + '}' > 'ৌ'
  + ']' > 'ো'
  + 'A' > 'অ'
  + 'a' > 'া'
  + 'S' > 'ষ'
  + 's' > 'স'
  + 'D' > 'ঢ'
  + 'd' > 'ড'
  + 'F' > 'থ'
  + 'f' > 'ত'
  + 'G' > 'ঘ'
  + 'g' > 'গ'
  + 'H' > 'ঃ'
  + 'h' > 'হ'
  + 'J' > 'ঝ'
  + 'j' > 'জ'
  + 'K' > 'খ'
  + 'k' > 'ক'
  + 'L' > 'ং'
  + 'l' > 'ল'
  + ':' > ':'
  + '"' > '"'
  + "'" > U+0027
  + '|' > '॥'
  + [K_BKSLASH] > U+200C
  + '~' > '~'
  + [K_BKQUOTE] > U+200D
  + 'Z' > 'য'
  + 'z' > 'য়'
  + 'X' > 'ঢ়'
  + 'x' > 'শ'
  + 'C' > 'ছ'
  + 'c' > 'চ'
  + 'V' > 'ঋ'
  + 'v' > 'আ'
  + 'B' > 'ভ'
  + 'b' > 'ব'
  + 'N' > 'ণ'
  + 'n' > 'ন'
  + 'M' > 'ঙ'
  + 'm' > 'ম'
  + '<' > 'ৃ'
  + ',' > ','
  + '>' > 'ঁ'
  + '.' > '।'
  + '?' > '?'
  + '/' > '্'

